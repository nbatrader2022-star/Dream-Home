# ==============================================================================
# NETLIFY, VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIVATE SERVER-SIDE ENVIRONMENT VARIABLES (Never expose to browser)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Used by backend AI advisor / Gemini endpoints (/api/gemini/advisor)
GEMINI_API_KEY=

# SUPABASE_URL: Private server connection URL for database operations
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Private elevated service-role key for backend admin operations
SUPABASE_SERVICE_ROLE_KEY=

# APP_URL: The base production URL of the deployed application (e.g., https://your-project.vercel.app)
APP_URL=

# ------------------------------------------------------------------------------
# 2. PUBLIC FRONTEND ENVIRONMENT VARIABLES (Vite client-side bundles)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: Public Supabase project API URL for client-side Auth
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Public Supabase anonymous key for client authentication
VITE_SUPABASE_ANON_KEY=

# Optional: Google Maps Platform API Key (for interactive property maps)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Firebase Client Configuration (if utilizing Firebase cloud synchronization)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

